# Paths are relative to this file, at the repo root. Patterns are unanchored,
# so __pycache__/ and .venv/ match at any depth (including text_pipeline/).

# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environment. Recreate with:
#   python -m venv .venv && .venv/bin/pip install -r requirements.txt
.venv/
venv/
env/
ENV/

# Packaging / build output
build/
dist/
*.egg-info/
*.egg

# Test and type-checker caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Editors
.idea/
.vscode/
*.swp

# macOS
.DS_Store

# Trained tokenizer artifacts.
#
# NOT ignored by default: a vocab.json / merges.txt pair is small, and
# committing it is what makes tokenization reproducible -- the same input must
# give the same ids on every machine, which is impossible if the vocabulary is
# regenerated locally. They are also the point of the project, so they belong
# in history.
#
# Uncomment if you start training on a large corpus and the files grow
# unwieldy, or point these at a dedicated output directory instead:
# vocab.json
# merges.txt

# Training corpora. Uncomment once bpe_trainer exists -- raw text corpora are
# typically far too large for git.
# corpus/
# data/
# *.txt.gz
